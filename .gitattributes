# Normalise line endings in the repository.
* text=auto eol=lf

# Keep Windows-oriented scripts usable after checkout on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Lockfiles are generated; keep them out of diffs that only reformat whitespace.
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
composer.lock linguist-generated=true
