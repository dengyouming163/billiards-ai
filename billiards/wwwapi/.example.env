APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
type = mysql
hostname = 127.0.0.1
database = database_name
username = database_user
password = database_password
hostport = 3306
charset = utf8mb4
prefix = bi_

[LANG]
default_lang = zh-cn

[PROJECT]
UNIQUE_IDENTIFICATION = likeadmin
DEMO_ENV = false
